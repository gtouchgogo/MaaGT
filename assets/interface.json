{
    "interface_version": 2,
    "name": "MaaGT",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "gtouchgogo@163.com",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/gtouchgogo/MaaGT",
    "version": "1.0.0",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "display_short_side": 1080,
            "win32": {
                "class_regex": ".*",
                "window_regex": "^Last Epoch$",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        }
    ],
    "resource": [
        {
            "name": "Last Epoch",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "../.venv/Scripts/python.exe",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {"name": "连续测试：3轮后停止", "entry": "BoundedRoundsTest"},
        {"name": "完整单轮：进入、拾取、返回选择器", "entry": "FullRoundTest"},
        {"name": "选择首领并进入Inside测试", "entry": "EnterInsideOnlyTest"},
        {"name": "Outside回到地图选择器测试", "entry": "OutsideReturnTest"},
        {"name": "传送门退出测试", "entry": "ExitPortalTest"},
        {"name": "祭坛互动拾取退出测试", "entry": "AltarInteractionTest"},
        {
            "name": "粉色与橙底物品拾取测试",
            "entry": "PinkOrangeLootTest"
        },
        {
            "name": "世界宝箱单次点击测试",
            "entry": "WorldChestClickTest"
        },
        {
            "name": "世界宝箱YOLO识别测试（不点击）",
            "entry": "WorldChestTest"
        },
        {
            "name": "Inside统一时钟回放测试",
            "entry": "InsideRouteClock"
        },
        {
            "name": "test",
            "entry": "CaptureTest"
        },
        {
            "name": "小地图宝箱识别测试",
            "entry": "MinimapTest"
        },
        {
            "name": "移动一秒后识别测试",
            "entry": "ApproachTest"
        },
        {
            "name": "Inside路线回放测试",
            "entry": "InsideRoute"
        },
        {
            "name": "选项任务",
            "entry": "MyTask2",
            "option": [
                "任务选项1"
            ]
        },
        {
            "name": "参数任务",
            "entry": "MyTask3",
            "option": [
                "任务选项1"
            ],
            "pipeline_override": {}
        },
        {
            "name": "自定义识别与动作示例",
            "entry": "FindSmallestNumber"
        }
    ],
    "option": {
        "任务选项1": {
            "type": "select",
            "cases": [
                {
                    "name": "文本1",
                    "pipeline_override": {
                        "OcrTask": {
                            "text": "文本1"
                        }
                    }
                },
                {
                    "name": "文本2",
                    "pipeline_override": {
                        "OcrTask": {
                            "text": "文本2"
                        }
                    }
                }
            ]
        }
    }
}
